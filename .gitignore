# Python cache
__pycache__/
*.py[cod]

# Model checkpoints -- large binaries (workspace/ckpts is ~1.3GB), staged
# via other means, not source
*.ckpt
*.pt
*.pth

# Generated build/submission archives -- regenerated via `python3 submission.py`
zip/
workspace/submission.zip

# Data-storage skeleton (regenerated by workspace tooling, not source)
dirs/

# Test input fixtures -- regenerable copies, see project history for how
# these were populated
input/

# Machine config / secrets -- config.json holds docker_token, docker_password,
# vast_api_key once set
id_*
config.json

# Runtime state between submission.py menu actions (current vast.ai
# instance, last pushed archive path) -- regenerated by create-vast/
# push-docker, not source
.submission_state.json
